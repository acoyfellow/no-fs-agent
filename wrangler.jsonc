{
  "$schema": "node_modules/wrangler/types/schema.json",
  "name": "no-fs-agent",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-04",
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "DRAFTS",
        "class_name": "Draft"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Draft"]
    }
  ],
  "workers_dev": true,
  "limits": {
    "cpu_ms": 300000
  }
}
